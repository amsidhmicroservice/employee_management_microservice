@startuml Update Employee Sequence
participant "API Gateway" as api
participant "Update Employee\nLambda" as lambda
participant "Update Employee\nService" as service
participant "DynamoDB" as db

api -> lambda: HTTP PUT /employees/{employee_id}
activate lambda

lambda -> lambda: Extract employee_id and request body
lambda -> service: update_employee(employee_id, employee_data)
activate service

service -> service: Validate employee data
service -> db: Update Item
activate db
db --> service: Updated data
deactivate db

service --> lambda: Employee updated
deactivate service

lambda --> api: HTTP 200 OK
deactivate lambda
@enduml